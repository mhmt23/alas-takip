# =============================================================================
# Alas Takip V1 — ortam değişkenleri şablonu (docs/V1-SPEC.md §2).
#
# Yerel kullanım:
#   1) Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
#   2) Başlatın:  node --env-file=.env server/index.js
#      (npm start .env dosyasını OKUMAZ; değişkenleri kabuğa ayarlamanız gerekir.)
#
# Railway'de bu dosya kullanılmaz; değerler servisin Variables bölümüne girilir.
#
# UYARI: Gerçek şifre ve SESSION_SECRET bu dosyaya yazılmaz, commit edilmez,
# loglara ve sohbete yapıştırılmaz. .env dosyası .gitignore'dadır.
# =============================================================================

# Dinlenecek port. Railway bunu kendisi verir; yerelde 3000.
PORT=3000

# Dinlenecek arayüz. Konteyner ve Railway için 0.0.0.0 gerekir.
HOST=0.0.0.0

# Kalıcı veri klasörü: users.json, sessions.json, main/, ornek/, web/, rapor/.
# Yerelde ./data. Railway'de Volume'un bağlandığı /data (Dockerfile'da zaten tanımlı).
DATA_DIR=./data

# Oturumsuz statik dosyalar (index.html, app.html, sw.js, fonts/).
PUBLIC_DIR=./public

# Çerez imza anahtarı (HMAC). ZORUNLU: NODE_ENV=production iken boşsa uygulama
# hata verip çıkar. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Değiştirirseniz açık tüm oturumlar geçersiz olur.
SESSION_SECRET=

# İlk yönetici hesabı. Yalnızca users.json yokken/boşken, açılışta bir kez oluşturulur.
# Oluşturulduğunda kullanıcı adı loglanır, şifre loglanmaz.
ADMIN_USER=
ADMIN_PASSWORD=

# Tarih dizgileri için saat dilimi. Varsayılan Europe/Istanbul.
TZ=Europe/Istanbul

# Arkada proxy (Railway edge) varken istemci IP'si için. Varsayılan: production'da true.
# Railway'de true kullanın: kenar + iç proxy olmak üzere iki atlama var; 1 veya 2 verildiğinde
# istemci yerine Railway'in iç adresi (100.64.x.x) görülüyor ve giriş hız sınırı (5/15 dk/IP)
# herkesi tek kovada topluyor. (true ile sahte X-Forwarded-For riski yalnız hız sınırını etkiler.)
# Değerler: true | false | atlama sayısı | IP/CIDR listesi.
# TRUST_PROXY=true

# Dışarıdan görünen kök adres; sihirli linkler bununla üretilir. Prod'da verin:
# Railway'in proxy zinciri X-Forwarded-Proto'yu "https, http" gönderdiğinden otomatik tespit
# http çıkabiliyor. Yalnız şema + alan adı, sonda / yok.
# PUBLIC_URL=https://alas-takip-production.up.railway.app

# Log seviyesi: fatal | error | warn | info | debug | trace. Varsayılan info.
LOG_LEVEL=info

# NODE_ENV=production; Secure çerez, HSTS ve zorunlu SESSION_SECRET getirir.
# Yerelde ayarlamayın: yerel denemede bu kurallar gereksiz engel çıkarır. Dockerfile'da ayarlı.
# NODE_ENV=development
